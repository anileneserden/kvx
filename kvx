    void (*print)(const char* s);
} kef_api_t;

typedef void (*kef_entry_fn)(kef_api_t* api);
""")

def interactive_menu(title, options):
    current_idx = 0
    import tty, termios
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    print(f"{BOLD}? {title}{RESET} (Yön tuşları ile seçin, Enter ile onaylayın)")
    try:
        tty.setraw(sys.stdin.fileno())
        while True:
            # Satırı başa al ve sağdaki tüm eski kalıntıları tamamen temizle (\033[K)
            sys.stdout.write("\r\033[K")
            
            output = ""
            for i, opt in enumerate(options):
                if i == current_idx:
                    output += f"{GREEN}{BOLD}> [x] {opt}{RESET}   "
                else:
                    output += f"  [ ] {opt}   "
            
            sys.stdout.write(output)
            sys.stdout.flush()
            
            ch = sys.stdin.read(1)
            if ch == '\x1b':
                sys.stdin.read(1)
                ch3 = sys.stdin.read(1)
                if ch3 == 'D':
                    current_idx = (current_idx - 1) % len(options)
                elif ch3 == 'C':
                    current_idx = (current_idx + 1) % len(options)
            elif ch == '\r' or ch == '\n':
                break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        print("\n")
    return options[current_idx]

KEF_VERSION = 2
KEF_ARCH_X86_32 = 1

def generate_kef(elf_path, out_path, preferred_addr, json_path=None):
    if ELFFile is None:
        print(f"{RED}[Hata] 'pyelftools' kurulu degil. Kurmak icin: pip install pyelftools --break-system-packages{RESET}")
        return False

    with open(elf_path, "rb") as f:
        elf = ELFFile(f)

        alloc_sections = []
        for sec in elf.iter_sections():
            if sec["sh_flags"] & 0x2:
                if sec["sh_type"] in ("SHT_PROGBITS", "SHT_NOBITS"):
                    alloc_sections.append(sec)
        alloc_sections.sort(key=lambda s: s["sh_addr"])

        code_sections = [s for s in alloc_sections if s["sh_type"] == "SHT_PROGBITS"]
        bss_sections   = [s for s in alloc_sections if s["sh_type"] == "SHT_NOBITS"]

        if not code_sections:
            print(f"{RED}[Hata] Yuklenecek (ALLOC) kod section'i bulunamadi.{RESET}")
            return False

        code_start = code_sections[0]["sh_addr"]
        code_end = max(s["sh_addr"] + s["sh_size"] for s in code_sections)
        code_size = code_end - code_start

        code_block = bytearray(code_size)
        for s in code_sections:
            off = s["sh_addr"] - code_start
            data = s.data()
            code_block[off:off+len(data)] = data

        bss_size = 0
        if bss_sections:
            bss_start = min(s["sh_addr"] for s in bss_sections)
            bss_end = max(s["sh_addr"] + s["sh_size"] for s in bss_sections)
            bss_size = bss_end - bss_start

        R_386_32 = 1
        relocs = []
        for sec in elf.iter_sections():
            if sec["sh_type"] != "SHT_REL":
                continue
            for rel in sec.iter_relocations():
                if rel["r_info_type"] != R_386_32:
                    continue
                r_vaddr = rel["r_offset"]
                if not (code_start <= r_vaddr < code_end):
                    continue
                relocs.append(r_vaddr - code_start)
        relocs.sort()

        entry_addr = None
        symtab = elf.get_section_by_name(".symtab")
        if symtab:
            for sym in symtab.iter_symbols():
                if sym.name == "_start":
                    entry_addr = sym["st_value"]
                    break

        if entry_addr is None:
            print(f"{RED}[Hata] '_start' sembolu bulunamadi.{RESET}")
            return False

        entry_off = entry_addr - preferred_addr

        # Eğer json_path parametresi verilmediyse, proje dizininde arayalım
        if not json_path:
            candidate1 = os.path.join(os.path.dirname(os.path.dirname(elf_path)), "layout.json")
            candidate2 = os.path.join(os.path.dirname(elf_path), "..", "layout.json")
            if os.path.exists(candidate1):
                json_path = candidate1
            elif os.path.exists(candidate2):
                json_path = candidate2

        json_bytes = b""
        if json_path and os.path.exists(json_path):
            with open(json_path, "r", encoding="utf-8") as jf:
                json_bytes = jf.read().encode("utf-8")

        HEADER_FMT = "<3sBB3xIIII II16s16s"
        name_bytes = os.path.basename(out_path).encode("utf-8")[:15].ljust(16, b"\0")
        reserved_bytes = b"\0" * 16

        header_size = struct.calcsize(HEADER_FMT)
        reloc_off = header_size + len(code_block)
        reloc_count = len(relocs)

        with open(out_path, "wb") as out:
            out.write(struct.pack(
                HEADER_FMT,
                b"KEF", KEF_VERSION, KEF_ARCH_X86_32,
                preferred_addr, entry_off,
                len(code_block), bss_size,
                reloc_count, reloc_off,
                name_bytes, reserved_bytes
            ))
            out.write(code_block)
            for off in relocs:
                out.write(struct.pack("<I", off))
            
            # JSON verisi mevcutsa __KFX_JSON__ etiketiyle beraber dosyaya iliştirilir
            if json_bytes:
                out.write(b"__KFX_JSON__")
                out.write(json_bytes)

    print(f"{GREEN}[kefgen] code_size={len(code_block)} bss_size={bss_size} reloc_count={reloc_count} json_appended={bool(json_bytes)}{RESET}")
    return True

def build_project(project_dir, clean_first=False):
    target_dir = os.path.abspath(project_dir)
    json_path = os.path.join(target_dir, "kvx.json")
    
    p_type = "app"
    sub_type = "cli"
    name = os.path.basename(target_dir)
    
    custom_cflags = ""
    custom_ldflags = ""
    
    if os.path.exists(json_path):
        try:
            with open(json_path, "r", encoding="utf-8") as f:
                jdata = json.load(f)
                p_type = jdata.get("type", "app")
                sub_type = jdata.get("sub_type", "cli")
                name = jdata.get("name", name)
                custom_cflags = jdata.get("compiler_flags", "")
                custom_ldflags = jdata.get("linker_flags", "")
        except:
            pass

    print(f"{CYAN}{BOLD}[*] Proje derleniyor: {target_dir}{RESET}")

    # p_type app_gui veya sub_type gui olan (veya genel app türündeki) projeler için i686
    target_arch = "i686" if p_type in ["app", "app_gui"] or sub_type == "gui" else "i386"

    if p_type == "app_cli":
        load_addr_str = "0x00500000"
        if os.path.exists(json_path):
            try:
                with open(json_path, "r", encoding="utf-8") as f:
                    load_addr_str = json.load(f).get("load_addr", load_addr_str)
            except:
                pass

        makefile_content = f"""TARGET = {name}
KUVIX_SDK_INC = $(HOME)/.kuvix/sdk/include
CC = i686-elf-gcc
LD = i686-elf-ld

BUILD = build
OBJ = $(BUILD)/main.o
ELF = $(BUILD)/$(TARGET).elf

CFLAGS = -ffreestanding -fno-pic -fno-pie -nostdlib -fno-asynchronous-unwind-tables \\
         -Wall -Wextra -O2 -I$(KUVIX_SDK_INC) {custom_cflags}
LDFLAGS = -T linker.ld -nostdlib --emit-relocs

.PHONY: all clean

all: $(ELF)

$(BUILD):
\tmkdir -p $(BUILD)

$(OBJ): main.c | $(BUILD)
\t$(CC) $(CFLAGS) -c main.c -o $(OBJ)

$(ELF): $(OBJ) linker.ld
\t$(LD) $(LDFLAGS) $(OBJ) -o $(ELF)

clean:
\trm -rf $(BUILD)
"""
        temp_makefile_path = os.path.join(target_dir, "Makefile")
        with open(temp_makefile_path, "w", encoding="utf-8") as f:
            f.write(makefile_content)

        if clean_first:
            subprocess.run(["make", "clean"], cwd=target_dir)

        result = subprocess.run(["make"], cwd=target_dir)

        if os.path.exists(temp_makefile_path):
            os.remove(temp_makefile_path)

        if result.returncode != 0:
            print(f"{RED}{BOLD}[-] Derleme sirasinda hata olustu!{RESET}")
            return False

        elf_path = os.path.join(target_dir, "build", f"{name}.elf")
        kef_path = os.path.join(target_dir, "build", f"{name}.kef")
        preferred_addr = int(load_addr_str, 16)

        if not generate_kef(elf_path, kef_path, preferred_addr):
            return False

        print(f"{GREEN}{BOLD}[+] Derleme basariyla tamamlandi! -> {kef_path}{RESET}")
        return True

    elif p_type == "app_gui":
        # app_gui projeleri doğrudan .kef üretir
        load_addr_str = "0x00500000"
        if os.path.exists(json_path):
            try:
                with open(json_path, "r", encoding="utf-8") as f:
                    load_addr_str = json.load(f).get("load_addr", load_addr_str)
            except:
                pass

        ldflags = custom_ldflags if custom_ldflags else "-m32 -nostdlib -T linker.ld --emit-relocs"

        makefile_content = f"""TARGET = {name}
KUVIX_SDK_INC = $(HOME)/.kuvix/sdk/include
CXX = i686-elf-g++
LD = i686-elf-ld

CXXFLAGS = -m32 -march={target_arch} -ffreestanding -fno-pic -fno-pie -fno-stack-protector \\
           -fno-builtin -fno-asynchronous-unwind-tables -Wall -Wextra -O2 \\
           -Iinclude -I$(KUVIX_SDK_INC) -fno-rtti -fno-exceptions {custom_cflags}

LDFLAGS = {ldflags}

BUILD = build
SRCS = $(shell find src -type f -name '*.cpp' 2>/dev/null)
OBJS = $(patsubst src/%.cpp, $(BUILD)/%.o, $(SRCS))
ELF = $(BUILD)/$(TARGET).elf

.PHONY: all clean

all: $(ELF)

$(BUILD):
\tmkdir -p $(BUILD)/runtime $(BUILD)/lib

$(BUILD)/%.o: src/%.cpp | $(BUILD)
\t@mkdir -p $(dir $@)
\t$(CXX) $(CXXFLAGS) -c $< -o $@

$(ELF): $(OBJS) linker.ld
\t$(LD) $(LDFLAGS) $(OBJS) -o $(ELF)

clean:
\trm -rf $(BUILD)
"""
        temp_makefile_path = os.path.join(target_dir, "Makefile")
        with open(temp_makefile_path, "w", encoding="utf-8") as f:
            f.write(makefile_content)

        if clean_first:
            subprocess.run(["make", "clean"], cwd=target_dir)

        result = subprocess.run(["make"], cwd=target_dir)

        if os.path.exists(temp_makefile_path):
            os.remove(temp_makefile_path)

        if result.returncode != 0:
            print(f"{RED}{BOLD}[-] Derleme sırasında hata oluştu!{RESET}")
            return False

        elf_path = os.path.join(target_dir, "build", f"{name}.elf")
        kef_path = os.path.join(target_dir, "build", f"{name}.kef")
        preferred_addr = int(load_addr_str, 16)

        # Doğrudan proje dizinindeki layout.json yolunu verelim
        project_json_path = os.path.join(target_dir, "layout.json")

        if not generate_kef(elf_path, kef_path, preferred_addr, json_path=project_json_path):
            return False

        print(f"{GREEN}{BOLD}[+] Derleme başarıyla tamamlandı! -> {kef_path}{RESET}")
        return True

    elif p_type == "de":
        ldflags = custom_ldflags if custom_ldflags else "-m elf_i386 -T linker.ld --gc-sections -e _start -s"
        
        makefile_content = f"""TARGET = {name}.kde
KUVIX_SDK_INC = $(HOME)/.kuvix/sdk/include
AS = i686-elf-as
CXX = i686-elf-g++
LD = i686-elf-ld

CXXFLAGS = -m32 -Wa,--32 -march={target_arch} -c -ffreestanding -fno-pic -fno-pie -mno-sse -mno-mmx -mno-80387 \\
           -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables \\
           -ffunction-sections -fdata-sections -Iinclude -I$(KUVIX_SDK_INC) \\
           -fno-rtti -fno-exceptions {custom_cflags}

LDFLAGS = {ldflags}

CPP_SRCS = $(shell find src -type f -name '*.cpp' 2>/dev/null)
CPP_OBJS = $(patsubst src/%.cpp, build/%.o, $(CPP_SRCS))

ENTRY_OBJ = build/runtime/entry.o
OBJS = $(ENTRY_OBJ) $(filter-out $(ENTRY_OBJ), $(CPP_OBJS))

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
\t$(LD) $(LDFLAGS) $(OBJS) -o $(TARGET)

build/runtime/entry.o: src/runtime/entry.s
\t@mkdir -p $(dir $@)
\t$(AS) --32 $< -o $@

build/%.o: src/%.cpp
\t@mkdir -p $(dir $@)
\t$(CXX) $(CXXFLAGS) $< -o $@

clean:
\trm -rf build {name}.kde
"""
        
    else:
        ldflags = custom_ldflags if custom_ldflags else "-m32 -nostdlib"
        
        cleaned_cflags = custom_cflags.replace("-march=i686", "").replace("-m32", "").replace("-ffreestanding", "").strip()
        
        makefile_content = f"""TARGET = {name}
SUB_TYPE = {sub_type}
KUVIX_SDK_INC = $(HOME)/.kuvix/sdk/include
CC = i686-elf-gcc
OBJCOPY = i686-elf-objcopy

CFLAGS = -m32 -march={target_arch} -ffreestanding -I$(KUVIX_SDK_INC) {cleaned_cflags}
LDFLAGS = {ldflags}

OUTPUT = $(TARGET).bin
all: $(OUTPUT)
$(OUTPUT):
\t@mkdir -p build
\t$(CC) $(CFLAGS) -c src/main.cpp -o build/main.o
\t$(CC) {ldflags} build/main.o -o $(TARGET).elf
\t$(OBJCOPY) -O binary $(TARGET).elf $(OUTPUT)
clean:
\trm -rf build/* $(TARGET).elf $(OUTPUT)
"""

    temp_makefile_path = os.path.join(target_dir, "Makefile")
    with open(temp_makefile_path, "w", encoding="utf-8") as f:
        f.write(makefile_content)

    if clean_first:
        subprocess.run(["make", "clean"], cwd=target_dir)

    result = subprocess.run(["make"], cwd=target_dir)

    if os.path.exists(temp_makefile_path):
        os.remove(temp_makefile_path)

    if result.returncode == 0:
        print(f"{GREEN}{BOLD}[+] Derleme başarıyla tamamlandı!{RESET}")
        return True
    else:
        print(f"{RED}{BOLD}[-] Derleme sırasında hata oluştu!{RESET}")
        return False

def create_project_structure(path, name, p_type, sub_type, version, author):
    ensure_sdk_exists()
    target_dir = os.path.abspath(os.path.join(path, name))

    if os.path.exists(target_dir):
        print(f"{RED}[Hata] '{target_dir}' dizini zaten mevcut!{RESET}")
        return False

    src_dir = os.path.join(target_dir, "src")
    include_dir = os.path.join(target_dir, "include")
    os.makedirs(src_dir, exist_ok=True)

    # Proje türüne özel varsayılan linker bayrakları
    default_ldflags = "-m32 -nostdlib"
    if p_type == "de":
        default_ldflags = "-m elf_i386 -N -e _start -T linker.ld"

    kvx_json_data = {
        "name": name, 
        "type": p_type, 
        "sub_type": sub_type,
        "version": version, 
        "author": author, 
        "compiler_flags": "-O2 -Wall -Wextra",
        "linker_flags": default_ldflags
    }
    with open(os.path.join(target_dir, "kvx.json"), "w", encoding="utf-8") as f:
        json.dump(kvx_json_data, f, indent=4, ensure_ascii=False)

    if p_type == "app_gui":
        os.makedirs(include_dir, exist_ok=True)
        runtime_dir = os.path.join(src_dir, "runtime")
        os.makedirs(runtime_dir, exist_ok=True)
        lib_dir = os.path.join(src_dir, "lib")
        os.makedirs(lib_dir, exist_ok=True)
        vscode_dir = os.path.join(target_dir, ".vscode")
        os.makedirs(vscode_dir, exist_ok=True)

        # 1. kvx.json (Uygulama Manifestosu)
        kvx_json_data = {
            "name": name,
            "type": "app_gui",
            "sub_type": sub_type,
            "version": version,
            "author": author,
            "compiler_flags": "-std=c++17 -O2 -Wall",
            "linker_flags": default_ldflags
        }
        # Not: Yukarıdaki genel kvx_json_data yazma adımından bağımsız, bu türe özel güncelleyebilirsin.

        # 2. layout.json (Arayüz Şablonu)
        layout_json_content = """{
  "window": {
    "title": "%s - KuvixOS",
    "width": 400,
    "height": 300
  },
  "elements": [
    {
      "type": "Label",
      "name": "lblStatus",
      "text": "KuvixOS KEF Sistemine Hos Geldiniz!",
      "x": 20,
      "y": 40
    },
    {
      "type": "Button",
      "name": "button1",
      "text": "Tikla ve Calistir",
      "x": 20,
      "y": 100,
      "width": 160,
      "height": 35
    }
  ]
}
""" % name
        with open(os.path.join(target_dir, "layout.json"), "w", encoding="utf-8") as f:
            f.write(layout_json_content)

        # 3. .vscode/c_cpp_properties.json
        c_cpp_properties_content = """{
    "configurations": [
        {
            "name": "KuvixOS-Freestanding",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include/**",
                "${userHome}/.kuvix/sdk/include"
            ],
            "defines": ["__FREESTANDING__"],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
"""
        with open(os.path.join(vscode_dir, "c_cpp_properties.json"), "w", encoding="utf-8") as f:
            f.write(c_cpp_properties_content)

        # 4. src/main.cpp (#include <kuvix.h> ve Event Mimarisi)
        main_code = """#include <kuvix.h>

// Butona tıklandığında çalışacak callback fonksiyonu
void onButtonClicked() {
    // SDK üzerinden element metnini değiştirme
    setElementText("lblStatus", "Basariyla .kef uygulamasi calistirildi!");
}

int main() {
    // 1. JSON arayüz şablonunu SDK üzerinden yükle
    loadUI("layout.json");

    // 2. Elementi seç ve olay (event) bağla
