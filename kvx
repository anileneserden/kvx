#!/usr/bin/env python3
import os
import sys
import json
import argparse
import subprocess
import shutil

VERSION = "0.1.8"

GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
BLUE = "\033[94m"
CYAN = "\033[96m"
RESET = "\033[0m"
