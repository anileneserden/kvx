def clean_project(project_dir):
    target_dir = os.path.abspath(project_dir)
    json_path = os.path.join(target_dir, "kvx.json")
    
    name = os.path.basename(target_dir)
    if os.path.exists(json_path):
        try:
            with open(json_path, "r", encoding="utf-8") as f:
                jdata = json.load(f)
                name = jdata.get("name", name)
        except:
            pass

    print(f"{CYAN}{BOLD}[*] Proje temizleniyor: {target_dir}{RESET}")
    
    build_path = os.path.join(target_dir, "build")
    if os.path.exists(build_path):
        shutil.rmtree(build_path)
        
    kde_file = os.path.join(target_dir, f"{name}.kde")
    if os.path.exists(kde_file):
        os.remove(kde_file)
        
    bin_file = os.path.join(target_dir, f"{name}.bin")
    if os.path.exists(bin_file):
        os.remove(bin_file)

    print(f"{GREEN}{BOLD}[+] Temizleme başarıyla tamamlandı!{RESET}")

def main():
    parser = argparse.ArgumentParser(description="KuvixOS CLI App & Driver SDK Tool")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("init", help="Yeni bir KuvixOS projesini interaktif olarak başlatır")

    create_parser = subparsers.add_parser("create", help="Projeyi parametrelerle veya interaktif olarak oluşturur")
    create_parser.add_argument("-t", "--type", choices=["driver", "app-cli", "app-gui", "de"])
    create_parser.add_argument("-n", "--name")
    create_parser.add_argument("-v", "--version", default="1.0.0")
    create_parser.add_argument("-a", "--author", default="Anıl Enes Erden")
    create_parser.add_argument("-d", "--dir", default=".")

    build_parser = subparsers.add_parser("build", help="Projeyi derler")
    build_parser.add_argument("-d", "--dir", default=".")
    build_parser.add_argument("-c", "--clean", action="store_true", help="Derlemeden önce temizlik yapar")

    clean_parser = subparsers.add_parser("clean", help="Projedeki build klasörünü me çıktıları temizler")
    clean_parser.add_argument("-d", "--dir", default=".")

    args = parser.parse_args()

    if args.command in ["init", "create", "build", "clean"]:
        print_logo()

    if args.command == "init" or (args.command == "create" and not getattr(args, 'type', None)):
        chosen_type = interactive_menu("Proje Türünü Seçin", ["driver", "app-cli", "app-gui", "de"])
        p_name = input(f"{BOLD}? Proje Adı: {RESET}").strip()
        if not p_name: return
        p_version = input(f"{BOLD}? Sürüm (1.0.0): {RESET}").strip() or "1.0.0"
        p_author = input(f"{BOLD}? Geliştirici: {RESET}").strip() or "Anıl Enes Erden"
        p_dir = input(f"{BOLD}? Klasör Yolu (.): {RESET}").strip() or "."
        p_type = "driver" if chosen_type == "driver" else "app" if "app" in chosen_type else chosen_type
        sub_type = "gui" if "gui" in chosen_type else "cli"
        create_project_structure(p_dir, p_name, p_type, sub_type, p_version, p_author)

    elif args.command == "create":
        p_type = "driver" if args.type == "driver" else "app" if "app" in args.type else args.type
        sub_type = "gui" if "gui" in args.type else "cli"
        create_project_structure(args.dir, args.name, p_type, sub_type, args.version, args.author)

    elif args.command == "build":
        build_project(args.dir, clean_first=args.clean)

    elif args.command == "clean":
        clean_project(args.dir)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
