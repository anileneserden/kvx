        int btn_x = x + width - theme.header_height + (theme.header_height - btn_size) / 2;
        int btn_y = y + (theme.header_height - btn_size) / 2;
        api->draw_rect(btn_x, btn_y, btn_size, btn_size, 0x00E63946);
    }
