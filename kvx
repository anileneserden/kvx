"""
        with open(os.path.join(src_dir, "main.cpp"), "w", encoding="utf-8") as f:
            f.write(main_code)

        print(f"{GREEN}{BOLD}[+][APP-GUI] '{target_dir}' JSON tabanlı DOM mimarisiyle başarıyla oluşturuldu!{RESET}")
        return True

    elif p_type == "app_cli":
        vscode_dir = os.path.join(target_dir, ".vscode")
        os.makedirs(vscode_dir, exist_ok=True)

        # 1. kvx.json
        kvx_json_data = {
            "name": name,
            "type": "app_cli",
            "sub_type": "cli",
            "version": version,
            "author": author,
            "load_addr": "0x00500000",
            "compiler_flags": "-O2 -Wall -Wextra",
            "linker_flags": ""
        }
        with open(os.path.join(target_dir, "kvx.json"), "w", encoding="utf-8") as f:
            json.dump(kvx_json_data, f, indent=4, ensure_ascii=False)

        # 2. .vscode/c_cpp_properties.json -> SDK include'a isaret eder (yerel include YOK)
        c_cpp_properties_content = """{
    "configurations": [
        {
            "name": "KuvixOS-Freestanding",
            "includePath": [
                "${workspaceFolder}/**",
                "${userHome}/.kuvix/sdk/include"
            ],
            "defines": ["__FREESTANDING__"],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}
"""
        with open(os.path.join(vscode_dir, "c_cpp_properties.json"), "w", encoding="utf-8") as f:
            f.write(c_cpp_properties_content)

        # 3. linker.ld
        linker_content = """ENTRY(_start)

SECTIONS
{
    . = 0x00500000;

    .text : {
        *(.text.start)
        *(.text*)
    }

    .rodata : { *(.rodata*) }
    .data   : { *(.data*) }
    .bss    : { *(COMMON) *(.bss*) }
}
"""
        with open(os.path.join(target_dir, "linker.ld"), "w", encoding="utf-8") as f:
            f.write(linker_content)

        # 4. main.c
        main_code = """#include "kef.h"

__attribute__((section(".text.start")))
void _start(kef_api_t* api) {
