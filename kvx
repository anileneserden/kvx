def ensure_sdk_exists():
    if not os.path.exists(SDK_INCLUDE_DIR):
        os.makedirs(SDK_INCLUDE_DIR, exist_ok=True)

    dedk_h_path = os.path.join(SDK_INCLUDE_DIR, "dedk.h")
    if not os.path.exists(dedk_h_path):
        with open(dedk_h_path, "w", encoding="utf-8") as f:
            f.write("""#pragma once
#ifdef __cplusplus
extern "C" {
#endif
typedef struct Window Window;
Window* create_window(const char* title, int width, int height);
bool window_is_open(Window* win);
void window_clear(Window* win, unsigned int color);
void window_present(Window* win);
#ifdef __cplusplus
}
#endif
""")

    kvxgfx_h_path = os.path.join(SDK_INCLUDE_DIR, "kvxgfx.h")
    if not os.path.exists(kvxgfx_h_path):
        with open(kvxgfx_h_path, "w", encoding="utf-8") as f:
            f.write("""#pragma once
