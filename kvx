__attribute__((section(".text.head"))) __attribute__((used))
KDF_Header driver_header = {{ KDF_MAGIC, 0x00000001, "{name}", (uint32_t)(void*)driver_init, 0, 0 }};
static KernelAPI* g_api = 0;
int driver_read(void* buffer, uint32_t size) {{
    if (!buffer || size == 0) return -1;
    const char* msg = "Hello from {name}!\\n";
    uint32_t len = 0; char* char_buf = (char*)buffer;
    while (msg[len] != '\\0' && len < (size - 1)) {{ char_buf[len] = msg[len]; len++; }}
    char_buf[len] = '\\0';
    return (int)len;
}}
int driver_init(KernelAPI* api, KDF_Operations* ops) {{
    g_api = api;
    if (g_api && g_api->printk) g_api->printk("[KDF] {name} surucusu yuklendi!\\n");
    if (ops) {{ ops->read = driver_read; ops->write = 0; ops->control = 0; }}
