#ifdef __cplusplus
}
#endif
""")

    kef_h_path = os.path.join(SDK_INCLUDE_DIR, "kef.h")
    if not os.path.exists(kef_h_path):
        with open(kef_h_path, "w", encoding="utf-8") as f:
            f.write("""#pragma once
